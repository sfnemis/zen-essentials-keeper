{
  "manifest_version": 2,
  "name": "Zen Essentials Keeper",
  "version": "2.1",
  "description": "Select specific essential/pinned tabs to force-load on startup and prevent unloading.",
  "permissions": [
    "tabs",
    "storage",
    "menus"
  ],
  "browser_action": {
    "default_icon": {
      "48": "icon.png"
    },
    "default_title": "Manage Essential Tabs",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "100.0"
    }
  }
}